/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'self'; upgrade-insecure-requests

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noimageai, noai

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noimageai, noai

/*.JPG
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noimageai, noai

/*.mp4
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noimageai, noai
